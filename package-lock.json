{
  "name": "axero",
  "version": "0.1.0-alpha",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "axero",
      "version": "0.1.0-alpha",
      "workspaces": [
        "packages/*",
        "playground/*"
      ]
    },
    "node_modules/@axero/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@axero/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@axero/ws": {
      "resolved": "packages/ws",
      "link": true
    },
    "node_modules/basic-test": {
      "resolved": "playground/basic-test",
      "link": true
    },
    "packages/cli": {
      "name": "@axero/cli",
      "version": "0.1.0-alpha",
      "bin": {
        "axero": "bin/axero.mjs"
      }
    },
    "packages/core": {
      "name": "@axero/core",
      "version": "0.1.0-alpha"
    },
    "packages/ws": {
      "name": "@axero/ws",
      "version": "0.1.0-alpha"
    },
    "playground/basic-test": {
      "version": "0.0.0"
    }
  }
}
